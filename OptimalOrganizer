#!/bin/sh
APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
APP_BIN="$APP_DIR/build/linux/x64/release/bundle/optimalorganizer"

if [ ! -x "$APP_BIN" ]; then
    printf '%s\n' "OptimalOrganizer could not find its executable: $APP_BIN" >&2
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="OptimalOrganizer could not start" \
            --text="The Dart app bundle is missing. Rebuild it with: flutter build linux --release"
    fi
    exit 127
fi

STATE_DIR=${XDG_STATE_HOME:-"$HOME/.local/state"}/optimalorganizer
if ! mkdir -p "$STATE_DIR" 2>/dev/null || [ ! -w "$STATE_DIR" ]; then
    STATE_DIR=${TMPDIR:-/tmp}
fi
exec "$APP_BIN" "$@" >>"$STATE_DIR/launcher.log" 2>&1
